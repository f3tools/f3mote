{
  "productName": "f3mote",
  "mainBinaryName": "f3mote",
  "version": "3.0.40",
  "identifier": "cc.f3mote.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "f3mote",
        "acceptFirstMouse": true,
        "width": 1280,
        "height": 840,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true,
        "maximized": true,
        "theme": "Dark",
        "titleBarStyle": "Transparent",
        "backgroundColor": "#2a2a2a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/f3tools/f3mote/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyOTlBNTdBMDQxREE2NjkKUldScHBoMEVlcVdaMHVrQ0VwcHBaZnMvUXYvbE14d2VwM0dHeUNid2Robm9SOU92TGZMeEdhakoK"
    }
  }
}
